<Window x:Class="WolfConquer.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WolfConquer · Client &amp; Source Hub" Width="1100" Height="720" MinWidth="960" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#080E0B" FontFamily="Segoe UI" Foreground="#E3EEE6">
  <Grid>
    <Image Source="{Binding HeroImage}" Stretch="UniformToFill" Opacity="0.72" IsHitTestVisible="False" />
    <Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
      <GradientStop Color="#FA070E0A" Offset="0" /><GradientStop Color="#E909140D" Offset="0.38" />
      <GradientStop Color="#AD0A160E" Offset="0.70" /><GradientStop Color="#55060D09" Offset="1" />
    </LinearGradientBrush></Rectangle.Fill></Rectangle>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="67" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Grid.ColumnSpan="2" BorderBrush="#395A43" BorderThickness="0,0,0,1" Background="#AA09120D" Padding="23,10">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Border Width="36" Height="38" Background="#153E27" BorderBrush="#5EDB97" BorderThickness="1" CornerRadius="7" Margin="0,0,13,0">
            <TextBlock Text="W" FontSize="23" FontWeight="Bold" Foreground="#82F0B1" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="WolfConquer" FontSize="23" FontWeight="SemiBold" />
            <TextBlock Text="CLIENT &amp; SOURCE HUB" FontSize="9" Foreground="#83AA92" Margin="1,0,0,0" /></StackPanel>
          <TextBlock Grid.Column="2" Text="EXPLICIT PATHS  /  CLEAR STATUS" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <Border Grid.Row="1" Background="#DD09140D" BorderBrush="#294C36" BorderThickness="0,0,1,0" Padding="15,24,15,16">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Bottom"><Border Height="1" Background="#294A35" Margin="4,0,4,14" />
            <TextBlock Text="BUILT TO KEEP CONTROL" Style="{StaticResource Eyebrow}" Margin="4,0,0,6" />
            <TextBlock Text="No silent installs.&#x0a;No source files mixed&#x0a;into your game client." FontSize="10" Foreground="#739480" LineHeight="16" Margin="4,0,0,0" />
          </StackPanel>
          <StackPanel><TextBlock Text="WORKSPACE" Style="{StaticResource Eyebrow}" Margin="12,0,0,15" />
            <Button Style="{StaticResource ClientNav}" Command="{Binding SelectClientCommand}" Content="◈   Client" />
            <Button Style="{StaticResource SourceNav}" Command="{Binding SelectSourceCommand}" Content="⌘   Source" />
            <TextBlock Text="Separate flows.&#x0a;One trusted starting point." FontSize="11" Foreground="#7E9C88" Margin="12,18,0,0" LineHeight="17" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Grid Grid.Row="1" Grid.Column="1" Margin="22,16,22,16">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,3,0">
          <StackPanel>
            <Grid Margin="0,0,0,13" MinHeight="87">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,14,0"><TextBlock Text="{Binding FlowEyebrow}" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="{Binding Headline}" FontSize="30" FontWeight="SemiBold" Margin="-1,5,0,5" />
                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#A8C0AF" TextWrapping="Wrap" MaxWidth="540" HorizontalAlignment="Left" />
              </StackPanel>
              <Border Grid.Column="1" Background="#D010281A" BorderBrush="#3D6B4C" BorderThickness="1" CornerRadius="14" Padding="10,6" VerticalAlignment="Top" Margin="0,3,0,0">
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center">
                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#769681" /><Style.Triggers>
                      <DataTrigger Binding="{Binding IsReady}" Value="True"><Setter Property="Fill" Value="#74F2AA" /></DataTrigger>
                      <DataTrigger Binding="{Binding IsAnimating}" Value="True">
                        <Setter Property="Fill" Value="#74F2AA" />
                        <DataTrigger.EnterActions><BeginStoryboard x:Name="StatusBreathing"><Storyboard RepeatBehavior="Forever" AutoReverse="True">
                          <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:1.1" />
                        </Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                        <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="StatusBreathing" /></DataTrigger.ExitActions>
                      </DataTrigger>
                    </Style.Triggers></Style></Ellipse.Style>
                  </Ellipse>
                  <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold" MaxWidth="185" TextWrapping="Wrap">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#96AF9F" /><Style.Triggers>
                      <DataTrigger Binding="{Binding IsReady}" Value="True"><Setter Property="Foreground" Value="#8FF7B5" /></DataTrigger>
                      <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Foreground" Value="#8DE5B0" /></DataTrigger>
                      <DataTrigger Binding="{Binding IsVisualPreview}" Value="True"><Setter Property="Foreground" Value="#DFEBAA" /></DataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Border>
            </Grid>
            <Border Visibility="{Binding IsVisualPreview, Converter={StaticResource BoolVisibility}}" Background="#3C332C10" BorderBrush="#A2B867" BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="0,0,0,10">
              <TextBlock Text="VISUAL PREVIEW · no update running · sample progress is not operational data" Foreground="#D9E7A5" FontSize="11" />
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
              <StackPanel IsEnabled="{Binding CanEditPaths}">
                <StackPanel Visibility="{Binding IsClientTab, Converter={StaticResource BoolVisibility}}">
                  <TextBlock Text="CONFIGURATION FILE" Style="{StaticResource FieldLabel}" />
                  <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding ConfigurationPath, UpdateSourceTrigger=PropertyChanged}" LostKeyboardFocus="Configuration_LostKeyboardFocus" ToolTip="Choose your local updater JSON configuration. No credentials are collected here." />
                    <Button Grid.Column="1" Content="Browse…" Style="{StaticResource ActionButton}" Padding="8,4" Margin="7,0,0,0" Click="BrowseConfiguration_Click" />
                  </Grid>
                </StackPanel>
                <StackPanel Visibility="{Binding IsClientTab, Converter={StaticResource BoolVisibility}}">
                  <TextBlock Text="CLIENT FOLDER · EXPLICIT LOCAL TARGET" Style="{StaticResource FieldLabel}" />
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding ClientRoot, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="Browse…" Style="{StaticResource ActionButton}" Padding="8,4" Margin="7,0,0,0" Click="BrowseClient_Click" />
                  </Grid>
                  <CheckBox IsChecked="{Binding AllowFreshInstall}" Margin="0,8,0,0" Content="Fresh client download · requires an empty/updater-only target folder" />
                  <TextBlock Text="{Binding LaunchWorkingDirectoryText, Mode=OneWay}" FontSize="10" Foreground="#84AD94"
                             TextWrapping="Wrap" Margin="0,7,0,0" ToolTip="Read-only local configuration. Relative directories are resolved inside the selected client folder at launch." />
                </StackPanel>
                <StackPanel Visibility="{Binding IsSourceTab, Converter={StaticResource BoolVisibility}}">
                  <TextBlock Text="CLEAN SOURCE CHECKOUT · NOT YOUR CLIENT FOLDER" Style="{StaticResource FieldLabel}" />
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SourceRoot, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="Browse…" Style="{StaticResource ActionButton}" Padding="8,4" Margin="7,0,0,0" Click="BrowseSource_Click" />
                  </Grid>
                  <TextBlock Text="Preserve local edits. A dirty or mismatched checkout must not be updated." FontSize="11" Foreground="#C2C6A2" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
              <StackPanel>
                <DockPanel><TextBlock Text="{Binding StageProgressText}" DockPanel.Dock="Right" Foreground="#8BEAB1" FontSize="11" />
                  <TextBlock Text="{Binding StageLabel}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" /></DockPanel>
                <ProgressBar Style="{StaticResource JadeProgress}" Value="{Binding StageProgress, Mode=OneWay}" IsIndeterminate="{Binding StageIndeterminate}" Margin="0,8,0,6" />
                <TextBlock Text="{Binding StatusDetail}" FontSize="11" Foreground="#94B29F" TextWrapping="Wrap" Margin="0,0,0,8" />
                <DockPanel><TextBlock Text="{Binding ByteProgressText}" DockPanel.Dock="Right" FontSize="10" Foreground="#84AD94" />
                  <TextBlock Text="{Binding ByteText}" FontSize="10" Foreground="#84AD94" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" /></DockPanel>
                <ProgressBar Style="{StaticResource JadeProgress}" Height="4" Foreground="#389B67" Value="{Binding ByteProgress, Mode=OneWay}" IsIndeterminate="{Binding ByteIndeterminate}" Margin="0,5,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="14,10" MinHeight="84">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="ACTIVITY" Style="{StaticResource Eyebrow}" Margin="0,0,0,7" />
                <TextBlock Grid.Row="1" Text="No activity yet. Nothing runs until you choose an action." FontSize="11" Foreground="#6E927C">
                  <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasActivity}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <ScrollViewer Grid.Row="1" MaxHeight="82" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasActivity, Converter={StaticResource BoolVisibility}}">
                  <ItemsControl ItemsSource="{Binding Activity}"><ItemsControl.ItemTemplate><DataTemplate>
                    <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="67" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="10" Foreground="#568569" />
                      <TextBlock Grid.Column="1" Text="{Binding Message}" FontFamily="Consolas" FontSize="10" Foreground="#B0CCB9" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1" Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Button Content="{Binding PrimaryLabel}" Command="{Binding PrimaryCommand}" Style="{StaticResource PrimaryButton}" MinWidth="153" />
          <Button Grid.Column="1" Content="Verify files" Command="{Binding VerifyCommand}" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Visibility="{Binding IsClientTab, Converter={StaticResource BoolVisibility}}" />
          <Button Grid.Column="2" Content="Launch client" Command="{Binding LaunchCommand}" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Visibility="{Binding IsClientTab, Converter={StaticResource BoolVisibility}}" />
          <Button Grid.Column="4" Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource ActionButton}" Margin="12,0,0,0" />
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
